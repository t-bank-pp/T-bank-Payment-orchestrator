# Local development only. Compose uses postgres:5432 inside its network.
PAYMENT_DATABASE_URL=postgresql+asyncpg://payment:payment@127.0.0.1:55432/payment_db
PAYMENT_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
PAYMENT_PUBLISHER_SEND_TIMEOUT=5
PAYMENT_PUBLISHER_POLL_INTERVAL=0.5
PAYMENT_PUBLISHER_RETRY_INTERVAL=1
PAYMENT_PUBLISHER_SHUTDOWN_TIMEOUT=5
PAYMENT_APP_NAME=Payment service
PAYMENT_DATABASE_CONNECT_TIMEOUT=3
# Optional: enables integration tests. This must be a disposable local/test
# PostgreSQL instance whose user can CREATE DATABASE; tests create their own DBs.
# TEST_DATABASE_URL=postgresql+asyncpg://payment:payment@127.0.0.1:55432/postgres
